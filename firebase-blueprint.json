{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered auditor and financial reviewer profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication User ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Auditor email address"
        },
        "displayName": {
          "type": "string",
          "description": "Full name of the auditor / reviewer"
        },
        "role": {
          "type": "string",
          "enum": ["STATUTORY_AUDITOR", "TAX_CONSULTANT", "COMPLIANCE_OFFICER", "CLIENT_ADMIN"],
          "description": "Access role within the firm"
        },
        "firmName": {
          "type": "string",
          "description": "Chartered Accountancy or Corporate Firm name"
        },
        "membershipNumber": {
          "type": "string",
          "description": "ICAI / ICSI Membership / COP number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Most recent login timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document containing auditor credentials and firm details"
    }
  }
}
